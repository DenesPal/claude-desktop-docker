# Copy to .env and adjust.

# Match your host user so X11 access and file ownership work (id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# Password for the container's login keyring (stores your sign-in)
KEYRING_PASSWORD=change-me

# Host folder mounted at /home/claude/workspace
WORKSPACE=./workspace

# Image options
WITH_COWORK=true
WITH_BROWSER=true
# Bump (e.g. to today's date) and rebuild to pick up a new app version
CACHE_BUST=0

# Only needed with compose.cowork.yaml: getent group kvm | cut -d: -f3
KVM_GID=

# Troubleshooting
CLAUDE_NO_SANDBOX=0
CLAUDE_DESKTOP_FLAGS=
